{
  "name": "fsw-aparatus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/check-runtime-env.ts && next build",
    "release:migrate": "prisma migrate deploy",
    "start": "tsx scripts/check-runtime-env.ts && next start",
    "worker": "tsx worker/index.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d postgres redis",
    "stack:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "reset:dev-account": "tsx scripts/reset-dev-account.ts",
    "dev:test-checkout": "tsx scripts/dev-create-test-subscription.ts",
    "dev:hosts": "tsx scripts/dev-hosts.ts",
    "env:doctor": "tsx scripts/env-doctor.ts",
    "make-superadmin": "tsx scripts/make-superadmin.ts",
    "retention:dry-run": "tsx scripts/purge-retention.ts",
    "retention:apply": "tsx scripts/purge-retention.ts --yes",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fingerprintjs/fingerprintjs": "^5.3.0",
    "@logtail/pino": "^0.5.12",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "6.18.0",
    "@prisma/nextjs-monorepo-workaround-plugin": "6.19.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@sentry/nextjs": "^10.65.0",
    "@sentry/node": "^10.65.0",
    "@stripe/stripe-js": "7.8.0",
    "@tanstack/react-query": "^5.104.5",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "1.7.12",
    "bullmq": "^5.80.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "17.2.3",
    "geist": "^1.8.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.42.2",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "next-safe-action": "8.7.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prisma": "6.18.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-big-calendar": "^1.20.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "19.3.1",
    "resend": "^6.34.1",
    "shiki": "^3.15.0",
    "sonner": "^2.0.8",
    "stripe": "22.1.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.1",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
