// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== AGENDAMENTO (Fase 2) =====

enum BookingStatus {
  PENDING_PAYMENT
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  WEB
  CHATBOT
  DASHBOARD
  RECURRING
}

enum PaymentMode {
  ON_SITE
  DEPOSIT
  FULL_PREPAYMENT
}

enum SubscriptionPlan {
  STARTER
  GROWTH
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  NONE
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum AbsenceType {
  VACATION
  SICK
  BLOCK
  OTHER
}

enum ClosedPeriodSource {
  MANUAL
  HOLIDAY_IMPORT
}

enum SettingsScope {
  ORGANIZATION
  LOCATION
  STAFF
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponScope {
  ALL_SERVICES
  SELECTED_SERVICES
}

enum MessageSenderType {
  CUSTOMER
  STAFF
}

enum CompensationType {
  MONTHLY
  HOURLY
  PER_SERVICE_COMMISSION
}

enum NotificationStatus {
  ACCEPTED
  FAILED
}

enum StripeEventStatus {
  PROCESSING
  PROCESSED
  FAILED
}

model Staff {
  id                        String              @id @default(uuid())
  organizationId            String
  organization              Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId                String
  location                  Location            @relation(fields: [locationId, organizationId], references: [id, organizationId])
  memberId                  String?             @unique // vínculo opcional a Member (staff sem login existe)
  invitationId              String?             @unique
  displayName               String
  bio                       String?
  imageUrl                  String?
  jobTitle                  String?
  color                     String? // cor no calendário do dashboard
  allowOverbooking          Boolean             @default(false)
  commissionBps             Int? // comissão em basis points (4000 = 40%)
  compensationType          CompensationType?
  compensationAmountInCents Int?
  isActive                  Boolean             @default(true)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @default(now()) @updatedAt
  workingHours              StaffWorkingHours[]
  absences                  StaffAbsence[]
  services                  StaffService[]
  bookings                  Booking[]

  @@unique([id, organizationId])
  @@index([organizationId, locationId])
  @@map("staff")
}

model StaffWorkingHours {
  id             String    @id @default(uuid())
  organizationId String
  staffId        String
  staff          Staff     @relation(fields: [staffId, organizationId], references: [id, organizationId], onDelete: Cascade)
  weekday        Int // 0 (domingo) – 6 (sábado)
  startTime      String // "09:00" no timezone do tenant
  endTime        String
  validFrom      DateTime? @db.Timestamptz
  validUntil     DateTime? @db.Timestamptz

  @@index([staffId, weekday])
  @@index([organizationId])
  @@map("staffWorkingHours")
}

model StaffAbsence {
  id             String      @id @default(uuid())
  organizationId String
  staffId        String
  staff          Staff       @relation(fields: [staffId, organizationId], references: [id, organizationId], onDelete: Cascade)
  type           AbsenceType @default(BLOCK)
  startAt        DateTime    @db.Timestamptz
  endAt          DateTime    @db.Timestamptz
  note           String?

  @@index([staffId, startAt])
  @@index([organizationId, startAt])
  @@map("staffAbsence")
}

model ClosedPeriod {
  id             String             @id @default(uuid())
  organizationId String
  locationId     String? // null = todas as filiais
  location       Location?          @relation(fields: [locationId, organizationId], references: [id, organizationId])
  name           String
  startAt        DateTime           @db.Timestamptz
  endAt          DateTime           @db.Timestamptz
  source         ClosedPeriodSource @default(MANUAL)

  @@index([organizationId, startAt])
  @@map("closedPeriod")
}

model Service {
  id                  String          @id @default(uuid())
  organizationId      String
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId          String? // null = todas as filiais
  location            Location?       @relation(fields: [locationId, organizationId], references: [id, organizationId])
  name                String
  description         String?
  imageUrl            String?
  durationMinutes     Int
  bufferBeforeMinutes Int             @default(0)
  bufferAfterMinutes  Int             @default(0)
  priceInCents        Int
  currency            String          @default("EUR")
  depositInCents      Int?
  paymentMode         PaymentMode? // null = regra padrão do tenant
  depositPercent      Int? // obrigatório quando paymentMode = DEPOSIT
  isActive            Boolean         @default(true)
  sortOrder           Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt
  staff               StaffService[]
  couponServices      CouponService[]
  images              ServiceImage[]
  bookings            Booking[]

  @@unique([id, organizationId])
  @@index([organizationId, isActive])
  @@map("service")
}

model ServiceImage {
  id             String   @id @default(uuid())
  organizationId String
  serviceId      String
  service        Service  @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  url            String
  publicId       String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId, serviceId])
  @@map("serviceImage")
}

model StaffService {
  organizationId String
  staffId        String
  staff          Staff   @relation(fields: [staffId, organizationId], references: [id, organizationId], onDelete: Cascade)
  serviceId      String
  service        Service @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([organizationId])
  @@index([serviceId])
  @@map("staffService")
}

model Customer {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String? // null = guest/walk-in
  name           String
  email          String?
  phone          String?
  locale         String?
  notes          String?
  noShowCount    Int              @default(0)
  isBlocked      Boolean          @default(false)
  tags           String[]         @default([])
  gdprErasedAt   DateTime?        @db.Timestamptz
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  bookings       Booking[]
  conversations  Conversation[]
  couponClaims   CustomerCoupon[]

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([organizationId, email])
  @@map("customer")
}

model Coupon {
  id             String           @id @default(uuid())
  organizationId String
  code           String // sempre armazenado uppercase
  type           CouponType
  value          Int // PERCENT: 1–100; FIXED: cents
  validFrom      DateTime?        @db.Timestamptz
  validUntil     DateTime?        @db.Timestamptz
  maxRedemptions Int?
  scope          CouponScope      @default(ALL_SERVICES)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  bookings       Booking[]
  services       CouponService[]
  customerClaims CustomerCoupon[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, isActive])
  @@map("coupon")
}

model CouponService {
  organizationId String
  couponId       String
  coupon         Coupon  @relation(fields: [couponId, organizationId], references: [id, organizationId], onDelete: Cascade)
  serviceId      String
  service        Service @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([couponId, serviceId])
  @@index([organizationId])
  @@index([serviceId])
  @@map("couponService")
}

model Booking {
  id                         String        @id @default(uuid())
  organizationId             String
  organization               Organization  @relation(fields: [organizationId], references: [id])
  locationId                 String
  location                   Location      @relation(fields: [locationId, organizationId], references: [id, organizationId])
  staffId                    String
  staff                      Staff         @relation(fields: [staffId, organizationId], references: [id, organizationId])
  serviceId                  String
  service                    Service       @relation(fields: [serviceId, organizationId], references: [id, organizationId])
  customerId                 String
  customer                   Customer      @relation(fields: [customerId, organizationId], references: [id, organizationId])
  startAt                    DateTime      @db.Timestamptz
  endAt                      DateTime      @db.Timestamptz // início + duração + buffers
  status                     BookingStatus
  source                     BookingSource @default(WEB)
  priceInCents               Int // snapshot no momento do booking
  currency                   String        @default("EUR")
  discountInCents            Int           @default(0)
  couponId                   String?
  coupon                     Coupon?       @relation(fields: [couponId], references: [id])
  paymentMode                PaymentMode   @default(ON_SITE)
  paymentStatus              PaymentStatus @default(NONE)
  paymentReceivedInCents     Int           @default(0)
  onlinePaymentAmountInCents Int           @default(0)
  refundedAmountInCents      Int           @default(0)
  paidAt                     DateTime?     @db.Timestamptz
  completedAt                DateTime?     @db.Timestamptz
  noShowAt                   DateTime?     @db.Timestamptz
  stripePaymentIntentId      String?
  stripeChargeId             String?
  stripeCheckoutSessionId    String?       @unique
  cancellationFeeInCents     Int?
  cancelledAt                DateTime?     @db.Timestamptz
  cancelledBy                String? // userId
  cancellationReason         String?
  expiresAt                  DateTime?     @db.Timestamptz // hold p/ PENDING_PAYMENT
  notes                      String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @default(now()) @updatedAt

  @@index([organizationId, startAt])
  @@index([staffId, startAt])
  @@index([customerId, startAt])
  @@index([organizationId, status])
  @@map("booking")
}

model TenantSettings {
  id             String        @id @default(uuid())
  organizationId String
  scope          SettingsScope @default(ORGANIZATION)
  scopeId        String? // locationId/staffId quando aplicável
  version        Int
  data           Json
  createdAt      DateTime      @default(now()) // append-only: nova row a cada mudança
  createdBy      String

  @@index([organizationId, scope, scopeId, createdAt(sort: Desc)])
  @@map("tenantSettings")
}

model User {
  id               String       @id
  name             String
  email            String
  emailVerified    Boolean      @default(false)
  image            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  // Plugin admin (Better Auth): SuperAdmin da plataforma
  role             String?
  banned           Boolean?
  banReason        String?
  banExpires       DateTime?
  // Plugin twoFactor (Better Auth)
  twoFactorEnabled Boolean?
  // Preferência de idioma do usuário (i18n)
  locale           String?
  sessions         Session[]
  accounts         Account[]
  members          Member[]
  invitations      Invitation[]
  twoFactors       TwoFactor[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Plugin organization: organização ativa na sessão
  activeOrganizationId String?
  // Plugin admin: impersonation de suporte
  impersonatedBy       String?

  @@unique([token])
  @@map("session")
}

// ===== TENANT (Organization = barbearia/rede) =====

enum OrgStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CHURNED
}

// Vertical do negócio — a plataforma não é mais exclusiva pra barbearia
// (ver app/(marketing)/find e app/app), então o diretório público e os
// chips de categoria em app/app precisam de algo além do nome do negócio
// pra filtrar por.
enum BusinessCategory {
  BARBERSHOP
  HAIR_SALON
  NAIL_SALON
  BEAUTY_SALON
  MEDICAL
  DENTAL
  ELECTRICIAN
  CONSTRUCTION
  OTHER
}

model Organization {
  id            String   @id
  name          String
  slug          String   @unique // subdomínio: {slug}.bladiq.com
  logo          String?
  coverImageUrl String? // hero da página pública (app/t/[slug])
  createdAt     DateTime @default(now())
  metadata      String?

  // Extensões próprias (fora do plugin Better Auth):
  timezone                     String             @default("Europe/Berlin")
  defaultLocale                String             @default("de")
  currency                     String             @default("EUR") // ISO 4217
  status                       OrgStatus          @default(TRIALING)
  brandingJson                 Json? // tokens de branding validados por Zod
  stripeCustomerId             String?            @unique
  stripeConnectAccountId       String?            @unique
  chargesEnabled               Boolean            @default(false) // Stripe Connect account.updated
  payoutsEnabled               Boolean            @default(false)
  subscriptionPlan             SubscriptionPlan?
  subscriptionStatus           SubscriptionStatus @default(TRIALING)
  stripeSubscriptionId         String?            @unique
  subscriptionCurrentPeriodEnd DateTime?          @db.Timestamptz
  trialEndsAt                  DateTime?          @db.Timestamptz
  gracePeriodEndsAt            DateTime?          @db.Timestamptz

  // Diretório público cross-tenant (lib/services/directory-service.ts):
  // liga sozinho quando o setup básico termina (decisão de produto do
  // roadmap 2026-07-21, Fase A2 — sem opt-in extra), mas nunca desliga
  // sozinho nem religa por cima de uma escolha manual do dono/manager —
  // `directoryListingSetByOwner` marca que a listagem já foi mexida à mão
  // (em qualquer direção) e faz o gate automático (dashboard/layout.tsx)
  // nunca mais tocar nela.
  isListed                   Boolean          @default(false)
  listedAt                   DateTime?        @db.Timestamptz
  directoryListingSetByOwner Boolean          @default(false)
  category                   BusinessCategory @default(OTHER)

  members          Member[]
  invitations      Invitation[]
  locations        Location[]
  staff            Staff[]
  services         Service[]
  customers        Customer[]
  bookings         Booking[]
  quoteRequests    QuoteRequest[]
  conversations    Conversation[]
  messages         Message[]
  customerCoupons  CustomerCoupon[]
  notificationLogs NotificationLog[]

  @@map("organization")
}

/**
 * Eventos Stripe processados, para tornar os webhooks idempotentes.
 */
model StripeEvent {
  id          String            @id // Stripe event id
  type        String
  accountId   String?
  status      StripeEventStatus @default(PROCESSING)
  attempts    Int               @default(1)
  startedAt   DateTime          @default(now()) @db.Timestamptz
  processedAt DateTime?
  lastError   String?

  @@index([status, startedAt])
  @@map("stripeEvent")
}

/**
 * Trilha de auditoria (GDPR + operacional) — append-only, nunca update/delete
 * pela aplicação. organizationId null = evento de plataforma (ex.: impersonation).
 * Entra em TENANT_MODELS (lib/db.ts) quando organizationId presente.
 */
/// Append-only audit trail for compliance and operational monitoring.
///
/// **Data Retention Policy:**
/// - Marketing/analytics events: 90 days (not required by regulation)
/// - Booking/payment/subscription events: 3 years (tax + fraud investigation)
/// - Customer erasure events: 3 years (GDPR proof of erasure)
///
/// Archival strategy: Create automated job to move old records to archive table
/// (future) after retention period expires. Use partition by date if >10M records.
/// Full picture (all models, not just this one): docs/data-retention-policy.md.
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  actorId        String? // userId de quem executou a ação
  entity         String // "Booking", "Customer", "Member", "Subscription", ...
  entityId       String?
  action         String // "BOOKING_CREATED", "CUSTOMER_ERASED", "DPA_ACCEPTED", ...
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("auditLog")
}

/**
 * Consentimentos (cookies, marketing) — imutável, escopo de plataforma.
 */
model ConsentLog {
  id        String   @id @default(uuid())
  userId    String?
  type      String // "cookies" | "marketing" | "dpa"
  version   String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@map("consentLog")
}

model Member {
  id                           String       @id
  organizationId               String
  organization                 Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                       String
  user                         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                         String // "owner" | "manager" | "professional" | "receptionist"
  createdAt                    DateTime     @default(now())
  // Prazo para ativar 2FA antes do redirect obrigatório (dashboard/layout.tsx).
  // Guardado (não computado de createdAt) para não mover retroativamente o
  // prazo de quem já tem conta se a política mudar depois.
  mfaGracePeriodEndsAt         DateTime?
  // Timestamp do envio do e-mail de lembrete (1 dia antes do prazo expirar).
  // Evita reenviar o lembrete a cada execução do job de varredura.
  mfaGracePeriodReminderSentAt DateTime?

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model TwoFactor {
  id          String  @id
  secret      String
  backupCodes String
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean @default(false)

  @@index([userId])
  @@map("twoFactor")
}

// ===== ESTRUTURA DO TENANT =====

model Location {
  id               String         @id @default(uuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  addressLine1     String
  addressLine2     String?
  postalCode       String
  city             String
  countryCode      String         @default("DE")
  phone            String?
  description      String? // curta, exibida na página pública de agendamento
  timezone         String? // override do timezone do tenant (raro)
  openingHoursJson Json? // horário por weekday, validado por Zod
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  staff            Staff[]
  services         Service[]
  closedPeriods    ClosedPeriod[]
  bookings         Booking[]
  quoteRequests    QuoteRequest[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([city])
  @@map("location")
}

enum QuoteRequestStatus {
  NEW
  CONTACTED
  CLOSED
}

/**
 * Pedido de orçamento — categorias que não funcionam por horário fixo
 * (ELECTRICIAN, CONSTRUCTION; ver lib/business-category.ts) não usam o
 * motor de disponibilidade/Booking, só captura de contato + notificação
 * pro staff. Sem negociação/threading e sem conversão automática pra
 * Booking — o tenant retoma contato manualmente (escopo deliberadamente
 * pequeno, ver docs/ROADMAP-2026-07-21.md Fase A2).
 */
model QuoteRequest {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location?          @relation(fields: [locationId, organizationId], references: [id, organizationId])
  customerName   String
  customerEmail  String?
  customerPhone  String?
  message        String
  status         QuoteRequestStatus @default(NEW)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("quoteRequest")
}

model TenantImpressum {
  id             String   @id @default(uuid())
  organizationId String   @unique
  legalName      String
  addressLine1   String
  postalCode     String
  city           String
  country        String   @default("DE")
  representedBy  String?
  phone          String?
  email          String?
  registerCourt  String?
  registerNumber String?
  vatId          String?
  updatedAt      DateTime @updatedAt
  updatedBy      String

  @@map("tenantImpressum")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// ===== MESSAGING & COUPONS (Fase B Hardening) =====

model Conversation {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  lastMessageAt      DateTime?    @db.Timestamptz
  lastStaffReadAt    DateTime?    @db.Timestamptz
  lastCustomerReadAt DateTime?    @db.Timestamptz
  createdAt          DateTime     @default(now())
  messages           Message[]

  @@unique([organizationId, customerId])
  @@unique([id, organizationId])
  @@index([organizationId, lastMessageAt(sort: Desc)])
  @@map("conversation")
}

model Message {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  senderType     MessageSenderType
  senderUserId   String // Better Auth User.id — not a FK (User isn't tenant-scoped), same pattern as Booking.cancelledBy
  body           String
  createdAt      DateTime          @default(now())

  @@index([organizationId, conversationId, createdAt])
  @@map("message")
}

model CustomerCoupon {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Cascade)
  couponId       String
  coupon         Coupon       @relation(fields: [couponId, organizationId], references: [id, organizationId], onDelete: Cascade)
  claimedAt      DateTime     @default(now())

  @@unique([customerId, couponId])
  @@index([organizationId])
  @@map("customerCoupon")
}

/**
 * Trilha append-only de tentativas de envio de notificação (Resend) feitas
 * pelo worker — sem isso, uma falha silenciosa do Resend (ex.: domínio não
 * verificado) marca o job do BullMQ como `completed` e ninguém percebe que
 * o e-mail nunca saiu. `type` reaproveita o mesmo rótulo do job/fila (ex.:
 * "booking.confirmation", "invitation.invite", "quoteRequest.notify",
 * "mfaReminder"). `channel` fica em EMAIL por enquanto, mas string livre
 * (não enum) para dar espaço a SMS/push sem migration.
 */
model NotificationLog {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  channel        String             @default("EMAIL")
  recipient      String
  status         NotificationStatus
  errorMessage   String?
  createdAt      DateTime           @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("notificationLog")
}
